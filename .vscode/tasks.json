{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active file",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "$compiler = 'C:\\mingw64\\bin\\g++.exe'; $standard = '-std=c++17'; if ([IO.Path]::GetExtension($env:SOURCE_FILE) -eq '.c') { $compiler = 'C:\\mingw64\\bin\\gcc.exe'; $standard = '-std=c17' }; & $compiler $standard -g -O0 -Wall -Wextra $env:SOURCE_FILE -o $env:OUTPUT_FILE; exit $LASTEXITCODE"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\mingw64\\bin;${env:PATH}",
                    "SOURCE_FILE": "${file}",
                    "OUTPUT_FILE": "${fileDirname}\\${fileBasenameNoExtension}.exe"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "run and pause",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "build active file",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\mingw64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}